# Environnement
ENVIRONMENT=development
DEBUG=true

# Base de données locale (développement)
DATABASE_URL=sqlite:///./clientpulse.db

# Clé secrète : à remplacer impérativement en production
SECRET_KEY=development-only-change-this-secret-key

# Durée de validité du jeton en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origines autorisées en développement
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
